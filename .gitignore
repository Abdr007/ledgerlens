# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Node
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Env & secrets — never commit
.env
.env.*
!.env.example

# Generated artifacts
eval/testset/**/*.pdf
eval/testset/**/*.png
eval/results/

# Real invoices, scored locally and never published. A real invoice carries a
# vendor, an address, a tax number, amounts and the recipient's own details — and
# `labels.json` restates all of it in plaintext, so committing the labels would
# publish the contents even where the document itself is ignored. Everything in
# here is excluded except the two files that document the shape.
eval/testset/private/*
!eval/testset/private/README.md
!eval/testset/private/labels.example.json
scripts/_out/
storage/

# OS
.DS_Store

# Written by scripts/deploy_space.py on the deploy commit only; the canonical
# copy lives in infra/Dockerfile.
/Dockerfile
