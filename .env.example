# ---------------------------------------------------------------------------
# LedgerLens — copy to `.env` and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Claude (the only paid-style resource; everything else is a free tier) ---
# Get one at https://console.anthropic.com/settings/keys
# Leave it blank and the API runs its deterministic offline extraction engine,
# so the whole pipeline still works end to end before you have a key.
ANTHROPIC_API_KEY=

# auto  -> live when a key is present, offline engine otherwise (default)
# live  -> require a key; fail fast if it is missing
# stub  -> never call the network (used by CI and the offline test suite)
LLM_MODE=auto

# Cost-aware model routing: a cheap model for the cheap decision.
MODEL_ROUTER=claude-haiku-4-5
MODEL_EXTRACTOR=claude-sonnet-4-6

# --- Database (Neon free tier in production, Docker Postgres locally) --------
# Neon: https://console.neon.tech -> project -> Connection string (pooled)
# Both `postgres://` and `postgresql://` are accepted and rewritten to asyncpg.
DATABASE_URL=postgresql+asyncpg://ledgerlens:ledgerlens@localhost:5433/ledgerlens

# --- Observability (Langfuse free cloud tier) -------------------------------
# https://cloud.langfuse.com -> Settings -> API Keys
# Optional: local tracing to the `llm_traces` table is always on regardless.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- HTTP surface -----------------------------------------------------------
# CORS is locked to these origins. Comma-separated. Never use "*".
# In production this is the Vercel domain, and it is set from SPACE_VARIABLES in
# scripts/deploy_space.py rather than by hand.
ALLOWED_ORIGINS=http://localhost:3000

# Spec §7: 10 requests per minute per IP on the expensive upload path.
RATE_LIMIT=10/minute
# Reads are cheap and the pipeline visual polls ~1/s, so they get their own limit.
READ_RATE_LIMIT=600/minute

# Number of reverse proxies in front of this service, for correct client-IP
# attribution. 0 = none (local); 1 on Hugging Face Spaces, which terminates TLS
# at exactly one proxy. Trust zero and every client shares one rate-limit bucket;
# trust the whole X-Forwarded-For chain and any caller can forge a fresh identity.
TRUSTED_PROXY_COUNT=0

# 10 MB, matching the PDF/PNG/JPG whitelist in spec §7.
MAX_UPLOAD_BYTES=10485760

# Hugging Face Spaces requires 7860. The container honours $PORT and falls back
# to this, so the same image runs anywhere.
API_PORT=7860

ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Web (apps/web) ---------------------------------------------------------
# Base URL of the API, used by the Next.js client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:7860
